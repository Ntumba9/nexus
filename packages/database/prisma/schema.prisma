// NEXUS database schema.
//
// Phase 1 intentionally declares no domain models: it establishes the datasource, the required
// PostgreSQL extensions and the migration pipeline. Domain models arrive with the phases that
// need them (see docs/database.md for the full design).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // vector: pgvector embeddings for the knowledge base (Phase 8). citext: case-insensitive emails.
  extensions = [vector, citext]
}

// ---------------------------------------------------------------------------------------------
// Phase 2: identity, organisations, membership, sessions.
//
// Tenancy: every organisation-owned table carries `organizationId`. Children of tenant-owned rows
// expose a composite unique (organizationId, id) so later phases can reference them with
// composite foreign keys, making cross-tenant references impossible at the database level.
// Additional CHECK constraints live in the migration SQL (Prisma cannot express them).
// ---------------------------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  DEVELOPER
  SUPPORT
  VIEWER
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// citext: unique case-insensitively, so "A@x.com" and "a@x.com" are the same account.
  email        String    @unique @db.Citext
  name         String
  /// Argon2id PHC string. Never returned by any API.
  passwordHash String
  disabledAt   DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  memberships       OrganizationMember[]
  sessions          Session[]
  incidentsCreated  Incident[]           @relation("IncidentCreatedBy")
  incidentEvents    IncidentEvent[]
  incidentComments  IncidentComment[]
  assignedIncidents IncidentAssignment[] @relation("AssignedUser")
  assignmentsMade   IncidentAssignment[] @relation("AssignedBy")
  deploymentLinks   IncidentDeployment[]
  rulesCreated      AutomationRule[]     @relation("RuleCreatedBy")
  webhooksCreated   OutboundWebhook[]    @relation("WebhookCreatedBy")
  auditEntries      AuditLog[]           @relation("AuditActor")
  documentsCreated  KnowledgeDocument[]  @relation("DocumentCreatedBy")
  documentsUpdated  KnowledgeDocument[]  @relation("DocumentUpdatedBy")
  investigations    AiInvestigation[]    @relation("InvestigationRequestedBy")
  passwordResets    PasswordReset[]
}

model Organization {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String   @unique
  /// Last allocated per-organisation incident number. Incremented atomically inside the incident
  /// creation transaction, so numbers are gap-free and never reused.
  incidentCounter Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  members   OrganizationMember[]
  projects  Project[]
  services  Service[]
  incidents Incident[]
  checks    MonitoringCheck[]

  githubIntegrations GitHubIntegration[]
  webhookEvents      WebhookEvent[]
  deployments        Deployment[]

  domainEvents         DomainEvent[]
  automationRules      AutomationRule[]
  automationExecutions AutomationExecution[]
  notifications        Notification[]
  outboundWebhooks     OutboundWebhook[]
  auditLogs            AuditLog[]
  knowledgeDocuments   KnowledgeDocument[]
  knowledgeChunks      KnowledgeChunk[]
  investigations       AiInvestigation[]
}

model OrganizationMember {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           Role
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  notifications Notification[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId])
}

model Session {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @db.Uuid
  /// SHA-256 of the opaque token held in the browser cookie. The raw token is never stored.
  tokenHash         String    @unique
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  lastUsedAt        DateTime  @default(now()) @db.Timestamptz(6)
  /// Idle expiry (sliding), never later than absoluteExpiresAt.
  expiresAt         DateTime  @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  ip                String?
  userAgent         String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------------------------
// Phase 3: projects, services, incidents.
//
// Tenant isolation is enforced by the database, not just the application: every child references
// its parent through a COMPOSITE foreign key (organizationId, parentId) -> parent(organizationId, id).
// A row can therefore never point at a parent that belongs to a different organisation, whatever
// the application does. (Optional parents, e.g. Incident.serviceId, use MATCH SIMPLE semantics:
// the check is skipped while the optional column is NULL.)
// ---------------------------------------------------------------------------------------------

enum ServiceEnvironment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

enum ServiceHealth {
  UNKNOWN
  HEALTHY
  DEGRADED
  DOWN
}

enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  MITIGATED
  RESOLVED
  CANCELLED
}

enum IncidentSource {
  MANUAL
  MONITORING
  AUTOMATION
  WEBHOOK
}

enum IncidentEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  SEVERITY_CHANGED
  ASSIGNED
  UNASSIGNED
  COMMENT_ADDED
  MONITORING_SIGNAL
  DEPLOYMENT_LINKED
  AUTOMATION_EXECUTED
  AI_INVESTIGATED
}

enum ActorType {
  USER
  SYSTEM
  AUTOMATION
  AI
}

model Project {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String              @db.Uuid
  name               String
  slug               String
  description        String              @default("")
  archivedAt         DateTime?           @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services           Service[]
  githubIntegrations GitHubIntegration[]
  deployments        Deployment[]

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
}

model Service {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String              @db.Uuid
  projectId          String              @db.Uuid
  name               String
  environment        ServiceEnvironment  @default(PRODUCTION)
  /// Aggregated from the service's checks by the monitoring worker. UNKNOWN means "not monitored",
  /// never "healthy".
  healthStatus       ServiceHealth       @default(UNKNOWN)
  healthChangedAt    DateTime?           @db.Timestamptz(6)
  description        String              @default("")
  archivedAt         DateTime?           @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project            Project             @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  incidents          Incident[]
  checks             MonitoringCheck[]
  githubIntegrations GitHubIntegration[]
  deployments        Deployment[]

  @@unique([organizationId, id])
  @@unique([organizationId, projectId, name, environment])
  @@index([organizationId, projectId])
}

model Incident {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String               @db.Uuid
  /// Human-facing, per-organisation sequence (INC-42). Unique with organizationId.
  number         Int
  serviceId      String?              @db.Uuid
  title          String
  description    String               @default("")
  severity       IncidentSeverity
  status         IncidentStatus       @default(OPEN)
  source         IncidentSource       @default(MANUAL)
  createdById    String?              @db.Uuid
  acknowledgedAt DateTime?            @db.Timestamptz(6)
  mitigatedAt    DateTime?            @db.Timestamptz(6)
  resolvedAt     DateTime?            @db.Timestamptz(6)
  cancelledAt    DateTime?            @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service        Service?             @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User?                @relation("IncidentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  events         IncidentEvent[]
  comments       IncidentComment[]
  assignments    IncidentAssignment[]
  tags           IncidentTag[]
  deployments    IncidentDeployment[]
  investigations AiInvestigation[]

  @@unique([organizationId, number])
  @@unique([organizationId, id])
  @@index([organizationId, status, severity])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, serviceId])
}

/// Append-only incident timeline. UPDATE, DELETE and TRUNCATE are rejected by database triggers.
model IncidentEvent {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @db.Uuid
  incidentId     String            @db.Uuid
  type           IncidentEventType
  actorType      ActorType
  actorId        String?           @db.Uuid
  data           Json              @default("{}")
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  incident       Incident          @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  actor          User?             @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([incidentId, createdAt])
  @@index([organizationId, createdAt(sort: Desc)])
}

model IncidentComment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  incidentId     String   @db.Uuid
  authorId       String   @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  incident       Incident @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  author         User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([incidentId, createdAt])
}

model IncidentAssignment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  incidentId     String    @db.Uuid
  userId         String    @db.Uuid
  assignedById   String    @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  /// Null while the assignment is active. A partial unique index allows one active row per user.
  unassignedAt   DateTime? @db.Timestamptz(6)
  incident       Incident  @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  user           User      @relation("AssignedUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy     User      @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([incidentId])
  @@index([userId])
}

model IncidentTag {
  organizationId String   @db.Uuid
  incidentId     String   @db.Uuid
  tag            String
  incident       Incident @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([incidentId, tag])
  @@index([organizationId, tag])
}

// ---------------------------------------------------------------------------------------------
// Phase 4: monitoring.
//
// A check belongs to a service through the composite tenant key; its results belong to the check
// the same way. The check row also carries the runtime state of the state machine (consecutive
// failures/successes, verdict, next run time) so scheduling and health survive restarts and can
// be shared safely between several workers.
// ---------------------------------------------------------------------------------------------

enum MonitoringCheckType {
  HTTP
}

enum CheckResultStatus {
  UP
  DOWN
}

model MonitoringCheck {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String              @db.Uuid
  serviceId         String              @db.Uuid
  name              String
  type              MonitoringCheckType @default(HTTP)
  url               String
  expectedStatus    Int                 @default(200)
  timeoutMs         Int                 @default(5000)
  intervalSeconds   Int                 @default(60)
  /// Consecutive failures before the check is DOWN (1 = a single failure is enough; opt-in).
  failureThreshold  Int                 @default(3)
  recoveryThreshold Int                 @default(2)
  incidentSeverity  IncidentSeverity    @default(SEV2)
  createIncidents   Boolean             @default(true)
  enabled           Boolean             @default(true)

  // Runtime state, written only by the monitoring worker.
  healthStatus         ServiceHealth @default(UNKNOWN)
  consecutiveFailures  Int           @default(0)
  consecutiveSuccesses Int           @default(0)
  lastCheckedAt        DateTime?     @db.Timestamptz(6)
  /// When the dispatcher should next schedule this check. Setting it to now() means "run soon".
  nextRunAt            DateTime      @default(now()) @db.Timestamptz(6)

  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(6)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service            @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  results      MonitoringResult[]

  @@unique([organizationId, id])
  @@index([enabled, nextRunAt])
  @@index([organizationId, serviceId])
}

model MonitoringResult {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @db.Uuid
  checkId        String            @db.Uuid
  status         CheckResultStatus
  statusCode     Int?
  responseTimeMs Int?
  /// One of the closed set in @nexus/shared FAILURE_REASONS; null when the check passed.
  failureReason  String?
  /// The scheduled execution slot. Unique per check, so a retried or duplicated job is recorded once.
  scheduledFor   DateTime          @db.Timestamptz(6)
  checkedAt      DateTime          @default(now()) @db.Timestamptz(6)
  check          MonitoringCheck   @relation(fields: [organizationId, checkId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([checkId, scheduledFor])
  @@index([checkId, checkedAt(sort: Desc)])
  @@index([checkedAt])
}

// ---------------------------------------------------------------------------------------------
// Phase 5: GitHub integration. Deployments arrive as signed webhooks (ADR-012). Every table keeps
// the composite tenant-safe foreign keys used above.
// ---------------------------------------------------------------------------------------------

enum IntegrationStatus {
  ACTIVE
  DISABLED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum DeploymentStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILURE
  INACTIVE
}

enum DeploymentRelation {
  SUSPECTED
  CONFIRMED
}

/// One GitHub repository delivering webhooks into one project (and optionally one service).
/// Removing an integration disables it; history is kept. A partial unique index (see the migration)
/// allows one ACTIVE integration per repository per organisation.
model GitHubIntegration {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String            @db.Uuid
  projectId              String            @db.Uuid
  serviceId              String?           @db.Uuid
  repoFullName           String
  /// AES-256-GCM, bound to this row's id. Never returned by the API after creation.
  webhookSecretEncrypted String
  status                 IntegrationStatus @default(ACTIVE)
  lastEventAt            DateTime?         @db.Timestamptz(6)
  createdAt              DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(6)
  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project                Project           @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  service                Service?          @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  events                 WebhookEvent[]
  deployments            Deployment[]

  @@unique([organizationId, id])
  @@index([organizationId, projectId])
}

/// A signature-verified webhook delivery. Deliveries with a bad signature are never stored.
model WebhookEvent {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @db.Uuid
  integrationId  String             @db.Uuid
  /// GitHub's X-GitHub-Delivery id; unique per integration so redelivery is recognised.
  deliveryId     String
  eventType      String
  payload        Json
  status         WebhookEventStatus @default(RECEIVED)
  error          String?
  receivedAt     DateTime           @default(now()) @db.Timestamptz(6)
  processedAt    DateTime?          @db.Timestamptz(6)
  integration    GitHubIntegration  @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, deliveryId])
  @@unique([organizationId, id])
  @@index([receivedAt])
}

model Deployment {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String               @db.Uuid
  projectId       String               @db.Uuid
  serviceId       String?              @db.Uuid
  integrationId   String               @db.Uuid
  /// GitHub's deployment id: unique per integration, so status updates upsert one row.
  externalId      String
  environment     String
  ref             String
  commitSha       String
  status          DeploymentStatus
  author          String?
  description     String?
  startedAt       DateTime             @db.Timestamptz(6)
  /// When the deployment first reported SUCCESS; null until then.
  deployedAt      DateTime?            @db.Timestamptz(6)
  /// Timestamp of the newest status applied; older events arriving late are ignored.
  statusUpdatedAt DateTime             @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project              @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  service         Service?             @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  integration     GitHubIntegration    @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  incidents       IncidentDeployment[]

  @@unique([integrationId, externalId])
  @@unique([organizationId, id])
  @@index([organizationId, startedAt(sort: Desc)])
  @@index([organizationId, serviceId, deployedAt(sort: Desc)])
}

model IncidentDeployment {
  organizationId String             @db.Uuid
  incidentId     String             @db.Uuid
  deploymentId   String             @db.Uuid
  relation       DeploymentRelation
  linkedById     String?            @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  incident       Incident           @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  deployment     Deployment         @relation(fields: [organizationId, deploymentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  linkedBy       User?              @relation(fields: [linkedById], references: [id], onDelete: Restrict)

  @@id([incidentId, deploymentId])
  @@index([deploymentId])
}

// ---------------------------------------------------------------------------------------------
// Phase 6: automation and notifications (ADR-013).
//
// The flow is: a change writes a DomainEvent in the SAME transaction (a transactional outbox), a
// worker matches rules against it, and each match becomes one AutomationExecution whose actions
// produce Notifications, outbound webhook calls or incidents. Configuration and consequential
// automation effects are recorded in the append-only AuditLog.
// ---------------------------------------------------------------------------------------------

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  SKIPPED
}

/// Trigger names ("incident.created", ...) are stored as text: the API, worker and UI all use the
/// same strings from @nexus/shared, and a CHECK constraint keeps the column honest.
///
/// The outbox: one row per thing that happened, written in the transaction that made it happen, so
/// an event can never be lost (or invented) if a process dies between the change and the enqueue.
model DomainEvent {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                @db.Uuid
  type                String
  /// The record the event is about (incident, service or deployment id); used for cooldowns.
  subjectId           String?               @db.Uuid
  /// Flat scalar facts that conditions and templates may read. Never a raw record.
  facts               Json
  /// Set when the event was itself caused by an automation execution. Such events never trigger
  /// automation (the loop guard).
  causedByExecutionId String?               @db.Uuid
  occurredAt          DateTime              @default(now()) @db.Timestamptz(6)
  /// Set by the dispatcher once rules have been evaluated. NULL means "still to do".
  dispatchedAt        DateTime?             @db.Timestamptz(6)
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions          AutomationExecution[]

  @@unique([organizationId, id])
  @@index([occurredAt])
}

model AutomationRule {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                @db.Uuid
  name            String
  trigger         String
  /// Validated by @nexus/shared (createRuleSchema) on every write and read back through it.
  conditions      Json                  @default("[]")
  actions         Json
  enabled         Boolean               @default(true)
  cooldownSeconds Int                   @default(300)
  createdById     String?               @db.Uuid
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(6)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?                 @relation("RuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  executions      AutomationExecution[]

  @@unique([organizationId, id])
  @@index([organizationId, trigger, enabled])
}

/// One rule matching one event. Unique per (rule, event): a redelivered or re-dispatched event can
/// never run a rule twice.
model AutomationExecution {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @db.Uuid
  ruleId         String          @db.Uuid
  eventId        String          @db.Uuid
  /// Denormalised so history stays readable and filterable without joining the outbox.
  eventType      String
  subjectId      String?         @db.Uuid
  status         ExecutionStatus @default(PENDING)
  skipReason     String?
  /// One entry per action: { index, type, status, detail }. Never a secret or a payload.
  results        Json            @default("[]")
  attempts       Int             @default(0)
  startedAt      DateTime?       @db.Timestamptz(6)
  finishedAt     DateTime?       @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  rule           AutomationRule  @relation(fields: [organizationId, ruleId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  event          DomainEvent     @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([ruleId, eventId])
  @@unique([organizationId, id])
  @@index([organizationId, ruleId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

/// A per-recipient in-app notification. The composite foreign key to OrganizationMember means a
/// notification can only ever exist for a member of its own organisation.
model Notification {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @db.Uuid
  userId         String             @db.Uuid
  type           String
  title          String
  body           String             @default("")
  /// An in-app path built by the server from ids ("/orgs/…"); never user input.
  link           String?
  readAt         DateTime?          @db.Timestamptz(6)
  /// Shown in the recipient's inbox. False for an email-only notification.
  inApp          Boolean            @default(true)
  /// NONE (not requested), PENDING, SENT or FAILED. Makes a retried action idempotent per recipient.
  emailStatus    String             @default("NONE")
  /// A short reason, never a message body or an address.
  emailError     String?
  /// Which execution and action produced it: unique per recipient, so a retried job cannot duplicate.
  executionId    String?            @db.Uuid
  actionIndex    Int?
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  member         OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: Restrict)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([executionId, actionIndex, userId])
  @@index([organizationId, userId, readAt, createdAt(sort: Desc)])
  @@index([createdAt])
}

/// A destination for the "call a webhook" action. The signing secret is AES-256-GCM encrypted with
/// the row id as authenticated data, shown once at creation and never returned again.
model OutboundWebhook {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String       @db.Uuid
  name            String
  url             String
  secretEncrypted String
  enabled         Boolean      @default(true)
  createdById     String?      @db.Uuid
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?        @relation("WebhookCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, enabled])
}

/// Append-only. UPDATE, DELETE and TRUNCATE are rejected by database triggers, so neither an
/// application bug nor a console session can rewrite it. Metadata is redacted before it is written.
model AuditLog {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  actorType      ActorType
  actorId        String?      @db.Uuid
  /// A snapshot of who acted, so the entry stays meaningful if the user is later renamed.
  actorLabel     String
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json         @default("{}")
  requestId      String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, action])
}

// ---------------------------------------------------------------------------------------------
// Phase 8: knowledge base.
//
// Chunks reference their document through a composite foreign key, so a chunk can only ever belong
// to a document of its own organisation. The vector and full-text search indexes are created in the
// migration SQL (Prisma cannot express them); every search query filters by organisation first.
// ---------------------------------------------------------------------------------------------

model KnowledgeDocument {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @db.Uuid
  title          String
  slug           String
  contentMd      String           @default("")
  tags           String[]         @default([])
  createdById    String?          @db.Uuid
  updatedById    String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?            @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?            @relation("DocumentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  chunks         KnowledgeChunk[]

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
  @@index([organizationId, updatedAt(sort: Desc)])
}

/// A searchable piece of a document. `embedding` is only ever read and written with raw SQL.
model KnowledgeChunk {
  id             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                      @db.Uuid
  documentId     String                      @db.Uuid
  ordinal        Int
  /// The document title and the headings above the chunk, searched together with the text.
  heading        String
  content        String
  /// SHA-256 of heading + content: an unchanged chunk keeps its embedding when a document is edited.
  contentHash    String
  embedding      Unsupported("vector(384)")?
  /// Which provider produced the vector. Vectors from different models are never compared.
  embeddingModel String?
  embeddedAt     DateTime?                   @db.Timestamptz(6)
  createdAt      DateTime                    @default(now()) @db.Timestamptz(6)
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document       KnowledgeDocument           @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId, documentId, ordinal])
  @@index([organizationId, embeddingModel])
}

// ---------------------------------------------------------------------------------------------
// Phase 9: AI investigation (ADR-016).
//
// An investigation stores the exact material it was given (`context`) next to its verified answer
// (`output`), so every citation can be opened and read later. It references its incident through the
// composite tenant key. At most one investigation per incident can be active at a time (a partial
// unique index in the migration SQL).
// ---------------------------------------------------------------------------------------------

enum InvestigationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model AiInvestigation {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String              @db.Uuid
  incidentId       String              @db.Uuid
  requestedById    String?             @db.Uuid
  status           InvestigationStatus @default(QUEUED)
  /// What the person asked, if anything. Untrusted text; only ever shown escaped.
  question         String?
  providerId       String
  /// The provider as a person would name it ("llama3.1 (Ollama)"), kept even if configuration changes.
  providerLabel    String
  /// The sources the analysis saw (ContextSource[]). Redacted and length-limited before it is stored.
  context          Json                @default("[]")
  /// The verified answer (InvestigationOutput). Set only when SUCCEEDED.
  output           Json?
  droppedCitations Int                 @default(0)
  droppedClaims    Int                 @default(0)
  downgradedCauses Int                 @default(0)
  truncated        Boolean             @default(false)
  /// A short, safe reason. Never a provider message, a URL or a key.
  error            String?
  attempts         Int                 @default(0)
  createdAt        DateTime            @default(now()) @db.Timestamptz(6)
  startedAt        DateTime?           @db.Timestamptz(6)
  finishedAt       DateTime?           @db.Timestamptz(6)
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident         Incident            @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy      User?               @relation("InvestigationRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId, incidentId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------------------------
// Phase 10: password reset (ADR-017).
//
// Only a SHA-256 of the token is stored, like session tokens, so a database leak yields no usable
// reset. A token is single-use (usedAt) and expires after an hour.
// ---------------------------------------------------------------------------------------------

model PasswordReset {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  ip        String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
