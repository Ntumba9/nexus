{
  "name": "@nexus/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./net-safety": {
      "types": "./dist/net-safety.d.ts",
      "default": "./dist/net-safety.js"
    },
    "./webhook-security": {
      "types": "./dist/webhook-security.d.ts",
      "default": "./dist/webhook-security.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "vitest": "3.2.7"
  }
}
