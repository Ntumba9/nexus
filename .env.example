# NEXUS local development configuration.
# Copy to `.env` (git-ignored):  cp .env.example .env
# These are development-only placeholders. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL (docker compose service `postgres`, pgvector image) ---
POSTGRES_PASSWORD=nexus_dev_password
# Host port for Docker's PostgreSQL. 5433 avoids clashing with a local PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433
# Connection string used when apps run on the host (pnpm dev). Inside Docker, compose overrides it.
DATABASE_URL=postgresql://nexus:nexus_dev_password@localhost:5433/nexus

# --- Redis (docker compose service `redis`) ---
REDIS_HOST_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API ---
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
SWAGGER_ENABLED=true
# Reverse proxies between the internet and the API whose X-Forwarded-For is trusted (0 = none).
TRUST_PROXY_HOPS=0
# Session cookie Secure flag. Leave unset to default to true in production.
# COOKIE_SECURE=false
SESSION_IDLE_TTL_HOURS=168
SESSION_ABSOLUTE_TTL_DAYS=30
# Auth rate limiting: max attempts per account per window (per-IP limits are derived from it).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# --- Web (server-side only; not exposed to the browser) ---
API_INTERNAL_URL=http://localhost:3001

# --- Monitoring (used by both the API and the workers; keep them equal) ---
# Allow health checks against private/internal addresses (localhost, 10.x, 192.168.x, metadata
# services...). OFF by default so monitoring cannot be used to probe the network NEXUS runs in
# (SSRF). Turn ON for local development or if you self-host and monitor internal services.
MONITORING_ALLOW_PRIVATE_NETWORKS=false
# How often the worker looks for checks that are due, and how long results are kept.
MONITORING_DISPATCH_INTERVAL_MS=5000
MONITORING_RESULT_RETENTION_DAYS=30

# --- Workers ---
WORKER_CONCURRENCY=5
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=3002

# --- AI (optional until Phase 9; the app runs without it and AI features stay disabled) ---
# Get a key at https://console.anthropic.com/ and put it ONLY in your local .env (never commit it).
ANTHROPIC_API_KEY=

# Container images used by `docker compose --profile app` (see README, "Full stack in Docker").
# NEXUS_IMAGE_REGISTRY=ghcr.io/ntumba9
# NEXUS_IMAGE_TAG=latest

# Encrypts GitHub and outbound-webhook secrets at rest. Integrations and outbound webhooks are
# disabled while this is empty. The api and the worker must have the SAME value.
# Generate with: openssl rand -base64 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Keep it: without it, existing secrets can no longer be read.
INTEGRATION_ENCRYPTION_KEY=

# Notifications and automation (worker).
# `log` writes emails to the worker log and needs no server; `smtp` sends them and needs SMTP_URL.
EMAIL_TRANSPORT=log
# SMTP_URL is a secret (it contains the login). Never commit a real one.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# EMAIL_FROM=NEXUS <nexus@example.com>
AUTOMATION_DISPATCH_INTERVAL_MS=1000
AUTOMATION_MAX_EXECUTIONS_PER_RULE_PER_HOUR=60
AUTOMATION_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=90

# Real-time updates (api). How often an open stream sends a keep-alive and re-checks the member and
# session (ms). Keep it below any reverse proxy's idle timeout; nginx defaults to 60 s.
REALTIME_HEARTBEAT_MS=15000
