    "@nexus/config": "workspace:*",
    "@nexus/database": "workspace:*",
    "@nexus/shared": "workspace:*",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.5",
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "@types/supertest": "7.2.1",
