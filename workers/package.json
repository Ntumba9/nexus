{
  "name": "@nexus/workers",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\" --exclude \"**/node_modules/**\"",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary",
    "test:integration": "vitest run integration",
    "smoke": "tsx scripts/enqueue-ping.ts"
  },
  "dependencies": {
    "@nexus/config": "workspace:*",
    "@nexus/database": "workspace:*",
    "@nexus/shared": "workspace:*",
    "bullmq": "6.3.7",
    "ioredis": "5.11.1",
    "nodemailer": "10.0.10"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/nodemailer": "8.0.2",
    "tsx": "4.23.13",
    "vitest": "3.2.7"
  }
}
